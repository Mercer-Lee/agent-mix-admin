# AgentMix local development environment variables (copy to .env; .env is gitignored — never commit real secrets)
# Note: plaintext secrets are likewise forbidden in any git-shared file (e.g. .zcode/config.json)

# Postgres (docker compose up -d postgres). Fill all values locally; never commit credentials.
# DATABASE_URL must use the same values as POSTGRES_USER / POSTGRES_PASSWORD / POSTGRES_DB.
# Shape only: postgres://<user>:<password>@localhost:5432/<database>
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
DATABASE_URL=

# Redis (docker compose up -d redis)
REDIS_URL=redis://localhost:6379

# Service ports
ADMIN_PORT=3100
SERVER_PORT=3101
ADMIN_ORIGIN=http://localhost:3100
# Default is false. When running behind a known proxy, provide explicit comma-separated CIDRs only.
TRUST_PROXY=false
# Used only by the Next.js server and rewrite target; never exposed to the browser bundle.
SERVER_INTERNAL_URL=http://localhost:3101

# Authentication
SESSION_TTL_HOURS=12
BOOTSTRAP_ADMIN_USERNAME=admin
# Required by `pnpm db:seed`; use at least 12 characters. Never commit a real value.
BOOTSTRAP_ADMIN_PASSWORD=

# ===== LLM / model gateway =====
# The execution plane uses Vercel AI SDK on an OpenAI-compatible protocol base; secrets always go through env vars, never the repo.
OPENAI_API_KEY=
# Required by the Worker. Set an absolute HTTPS OpenAI-compatible API base URL.
# Plain HTTP is accepted only for localhost/127.0.0.1 test gateways.
OPENAI_BASE_URL=
# Default model profile model ID seeded by `pnpm db:seed`.
# MCP tool server auth: the database stores only the env var NAME per MCP server
# (see apps/server mcp module); the secret value is resolved from this process
# environment at connect time. Example:
# MCP_GITHUB_TOKEN=
MODEL=
