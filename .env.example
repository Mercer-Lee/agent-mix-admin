# AgentMix 本地开发环境变量（复制为 .env 使用；.env 已被 gitignore，禁止提交真实密钥）
# 注意：.zcode/config.json 等任何随 git 共享的文件中同样禁止出现明文密钥

# Postgres（docker compose up -d postgres）
DATABASE_URL=postgres://agentmix:agentmix@localhost:5432/agentmix

# Redis（docker compose up -d redis）
REDIS_URL=redis://localhost:6379

# 服务端口
ADMIN_PORT=3100
SERVER_PORT=3101
